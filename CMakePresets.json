{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "windows-clang",
            "displayName": "Windows (clang-cl)",
            "description": "clang-cl + lld-link; finds Visual Studio's headers and the Windows SDK by itself",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_LINKER": "lld-link",
                "CMAKE_MT": "llvm-mt"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "windows-clang-counts",
            "displayName": "Windows (clang-cl, call counting)",
            "description": "instrumented build for frame-rate analysis (out/SonicColorsRecomp_counts.exe)",
            "inherits": "windows-clang",
            "cacheVariables": { "SCR_CALL_COUNTS": "ON" }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows (MSVC)",
            "description": "cl + link; run from a Visual Studio x64 Developer prompt",
            "inherits": "base",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux (clang)",
            "description": "clang; SDL3, dxvk-native and vkd3d-shader are downloaded (docs/linux.md)",
            "inherits": "base",
            "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "windows-mingw",
            "displayName": "Windows (MinGW-w64 cross from Linux)",
            "description": "x86_64-w64-mingw32-g++; native Win32/D3D11 runtime; output in out-windows/ (docs/windows-cross.md)",
            "inherits": "base",
            "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SCR_OUT_DIR": "${sourceDir}/out-windows"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "windows-mingw-debug",
            "displayName": "Windows (MinGW-w64 Debug cross)",
            "description": "Debug configuration of windows-mingw",
            "inherits": "windows-mingw",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        }
    ],
    "buildPresets": [
        { "name": "windows-clang", "configurePreset": "windows-clang" },
        { "name": "windows-clang-counts", "configurePreset": "windows-clang-counts" },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc",
            "jobs": 2,
            "targets": ["SonicColorsRecomp"]
        },
        { "name": "linux-clang", "configurePreset": "linux-clang" },
        { "name": "windows-mingw", "configurePreset": "windows-mingw" },
        { "name": "windows-mingw-debug", "configurePreset": "windows-mingw-debug" }
    ]
}
